# FutureVisor 어드민 AI 분석 서버 — 컨테이너 이미지
#
# - Node 22 slim 베이스
# - @anthropic-ai/claude-agent-sdk 의존성 설치
# - 사용자의 ~/.claude/.credentials.json 을 볼륨으로 마운트해 OAuth 세션 재사용
# - 별도 ANTHROPIC_API_KEY 불필요 → 구독 한도로 무료

FROM node:22-bookworm-slim

# claude CLI 가 호출할 수 있는 git/ripgrep 등 기본 도구 (SDK가 도구 없이 단발성 호출만 하지만 안전망)
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Claude Code CLI 전역 설치 — Agent SDK가 child process로 `claude` 를 spawn 함
RUN npm install -g @anthropic-ai/claude-code --no-audit --no-fund

# 프로젝트 의존성 캐시 레이어
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
  && npm cache clean --force

# 실행 스크립트만 복사 (Vite/리액트 등 전체 소스 불필요)
COPY scripts/admin-ai-server.mjs ./scripts/admin-ai-server.mjs

ENV NODE_ENV=production
ENV FV_AI_PORT=3001
EXPOSE 3001

# 컨테이너 안에서 HOME=/root → /root/.claude 로 자격증명 마운트됨
CMD ["node", "scripts/admin-ai-server.mjs"]
