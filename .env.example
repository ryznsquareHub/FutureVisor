# 모든 시크릿은 Doppler (project: perfoads, config: prd)에서 관리됩니다.
# 로컬 개발: `npm run dev:doppler` (사전에 `doppler login` 필요)
# Vercel: Doppler-Vercel 네이티브 통합으로 자동 동기화
# 통합 미설정 상태로 로컬 npm run dev 만 돌릴 때는 아래 변수에 값을 채워서 .env.local 로 복사하세요.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# EmailJS 템플릿 Bcc 칸에 {{bcc}} 를 넣으면 contact@ryznsquare.com 으로 숨은참조가 갑니다.

# Supabase (방문자 트래킹 + /admin 대시보드)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

